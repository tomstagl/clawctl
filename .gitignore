.DS_Store
*.bak
*.bak.*
.cache/

# Go build artifacts. `go build ./cmd/clawctl` from the repo root currently
# overwrites the bash `clawctl` entrypoint — that collision is resolved when
# US-031 renames the bash script to clawctl.bash. Until then, contributors
# should `go build -o /tmp/clawctl ./cmd/clawctl` (or similar) to avoid
# clobbering the tracked file.
/cmd/clawctl/clawctl
*.test

# Scratch dir for parity-test Go binaries (test/parity-*.sh build into
# the repo tree because /tmp-rooted Mach-O binaries have hit `missing
# LC_UUID load command` failures on some macOS hosts).
/.test-bin/

